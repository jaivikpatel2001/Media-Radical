# =============================================================================
# Media Radical — environment variables
#
# Copy this file to `.env.local` and fill in the values:
#
#     cp .env.example .env.local
#
# `.env.local` is git-ignored. Never commit real keys, and never put a secret
# in a NEXT_PUBLIC_* variable — anything with that prefix is inlined into the
# JavaScript bundle and is readable by every visitor.
#
# HONEST STATUS: the site currently runs with NO configuration at all. Only the
# first variable below is read by code today. The rest are listed because the
# features that need them are planned and partially scaffolded — each is marked
# so this file never drifts into describing things that do not exist.
#
# When you add a variable: add it here with a placeholder and a comment, and
# note it in README.md and DONE.md. See CLAUDE.md.
# =============================================================================


# -----------------------------------------------------------------------------
# ACTIVE — read by code today
# -----------------------------------------------------------------------------

# Absolute public origin of this deployment, no trailing slash.
# Read by: data/site.ts -> app/layout.tsx (metadataBase), app/sitemap.ts,
#          app/robots.ts, utils/schema.ts (JSON-LD @id).
# Falls back to https://mediaradical.in when unset, so local development works
# without any .env file.
# Set this per environment. That fallback is exactly why: a deployment left
# unset does not fail, it quietly publishes canonical URLs and sitemap entries
# pointing at production, which invites Google to deduplicate it away.
#   Local:      http://localhost:3000
#   Render:     https://media-radical.onrender.com
#   Production: https://mediaradical.in
# On Render this is declared in render.yaml with `sync: false`, so it is set in
# the dashboard per service rather than committed here.
#
# NOTE: this is a NEXT_PUBLIC_* variable, so it is inlined at BUILD time.
# Changing it in the Render dashboard needs a redeploy, not just a restart.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# PLANNED — not read by any code yet. Uncomment as each feature is wired up.
# -----------------------------------------------------------------------------

# --- Newsletter (footer form) -------------------------------------------------
# Where components/layout/FooterNewsletter.tsx posts the address. Any endpoint
# that accepts a POST works: a form relay such as FormSubmit or Formspree, or a
# mailing-list provider's own URL.
#
# Leaving it unset is a supported state, not a broken one. The form validates
# as normal and then says signup is not connected, pointing at the contact
# address. It never thanks someone for a subscription that went nowhere.
#
# This must be NEXT_PUBLIC_, and therefore must NOT be a secret: the site is a
# static export with no server, so the request is made from the browser and the
# value is visible in the page source. A provider API key cannot be used here.
# If one is ever needed, the site has to move back to a Web Service.
# NEXT_PUBLIC_NEWSLETTER_ENDPOINT=https://formsubmit.co/ajax/your-address

# --- Contact form (page group 9, /contact) ------------------------------------
# Where enquiries are delivered once the contact page is built.
# CONTACT_FORM_TO_EMAIL=newbusiness@mediaradical.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_username_here
# SMTP_PASSWORD=your_smtp_password_here

# Spam protection for that form. The site key is public by design; the secret
# key must never be exposed to the browser.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_public_site_key_here
# TURNSTILE_SECRET_KEY=your_secret_key_here

# --- Analytics ----------------------------------------------------------------
# No analytics are loaded today. Whatever is added must respect the cookie
# policy described in page group 14.
# NEXT_PUBLIC_ANALYTICS_ID=your_measurement_id_here

# --- Maintenance mode (page group 17) -----------------------------------------
# Set to "true" to have proxy.ts rewrite all traffic to /maintenance.
# NOTE: Next.js 16 renamed `middleware.ts` to `proxy.ts`, and the proxy runtime
# is Node.js and not configurable. See app/ROUTES.md.
# MAINTENANCE_MODE=false
